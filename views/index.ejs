<!DOCTYPE html>
<html lang="uk">
<head>
  <%- include('ejs/head', { title: 'Усі голосування' }) %>
</head>
<body>
  <%- include('ejs/header') %>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-content">
          <span class="eyebrow">Онлайн голосування</span>
          <h1>Усі доступні голосування в одному місці</h1>
          <p>
            Обирайте активні голосування, переглядайте результати та швидко переходьте
            до потрібного опитування.
          </p>
          <div class="hero-actions">
            <a href="/admin/polls/new" class="btn btn-primary">Створити голосування</a>
            <a href="/admin" class="btn btn-secondary">Перейти в адмінку</a>
          </div>
        </div>

        <div class="hero-card">
          <div class="hero-card__top">
            <span class="badge badge-active">Активне</span>
          </div>
          <h3>Приклад голосування</h3>
          <p>Оберіть найкращого кандидата серед доступних варіантів.</p>
          <div class="hero-stats">
            <div>
              <strong>4</strong>
              <span>кандидати</span>
            </div>
            <div>
              <strong>1</strong>
              <span>голос на людину</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Голосування</h2>
            <p class="section-subtitle">Список усіх доступних голосувань</p>
          </div>

          <div class="toolbar">
            <input
              type="text"
              id="pollSearch"
              class="input"
              placeholder="Пошук за назвою..."
            />


          </div>
        </div>

        <div class="poll-grid" id="pollGrid"></div>
        <p class="empty-state hidden" id="noResultsMessage">Нічого не знайдено за вашим запитом.</p>

      </div>
    </section>
  </main>

  <%- include('ejs/footer') %>

  <div id="toast"></div>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    loadPetitions();
    initPollFilters();
  });

  // ─── ЗАВАНТАЖЕННЯ ПЕТИЦІЙ ───────────────────────────────────────────────────

  async function loadPetitions() {
    try {
      const res = await fetch('/api/petitions');
      const result = await res.json();

      const pollGrid = document.getElementById('pollGrid');
      const noResults = document.getElementById('noResultsMessage');
      if (!pollGrid) return;

      if (!result.success) {
        showToast(result.message);
        return;
      }

      if (result.petitions.length === 0) {
        pollGrid.innerHTML = `
          <div class="empty-box">
            <h3>Поки що голосувань немає</h3>
            <p>Створіть перше голосування в адмін панелі.</p>
            <a href="/admin/polls/new" class="btn btn-primary">Створити</a>
          </div>
        `;
        return;
      }

      pollGrid.innerHTML = '';

      result.petitions.forEach(petition => {
        const card = document.createElement('article');
        card.className = 'poll-card';
        card.dataset.title = petition.name.toLowerCase();
        card.dataset.status = 'active';

        card.innerHTML = `
          <div class="poll-card__top">
            <span class="badge badge-active">Активне</span>
          </div>
          <h3 class="poll-card__title">${petition.name}</h3>
          <p class="poll-card__description">${petition.text}</p>
          <div class="poll-card__actions">
            <a href="/polls/${petition.id}" class="btn btn-primary btn-sm">Проголосувати</a>
            <a href="/polls/${petition.id}/results" class="btn btn-secondary btn-sm">Результати</a>
          </div>
        `;

        pollGrid.appendChild(card);
      });

    } catch (err) {
      console.error('Помилка завантаження петицій:', err);
      showToast('Сервер недоступний');
    }
  }

  // ─── ФІЛЬТРАЦІЯ ─────────────────────────────────────────────────────────────

 function initPollFilters() {
  const searchInput = document.getElementById('pollSearch');
  const pollGrid = document.getElementById('pollGrid');
  const noResults = document.getElementById('noResultsMessage');
  if (!searchInput || !pollGrid) return;

  searchInput.addEventListener('input', () => {
    const searchValue = searchInput.value.trim().toLowerCase();
    const cards = Array.from(pollGrid.querySelectorAll('.poll-card'));
    let visibleCount = 0;

    cards.forEach(card => {
      const title = (card.dataset.title || '').toLowerCase();
      const visible = title.includes(searchValue);
      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
  });
}
  // ─── TOAST ──────────────────────────────────────────────────────────────────

  function showToast(message) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2200);
  }
  </script>
</body>
</html>