<!DOCTYPE html>
<html lang="uk">
<head><%- include('ejs/head', { title: 'Результати' }) %></head>
<body>
  <%- include('ejs/header') %>
  <main class="section">
    <div class="container narrow-container">
      <div class="page-top">
        <a href="/" class="back-link">← Назад до всіх голосувань</a>
      </div>

      <section class="details-card">
        <div class="results-head">
          <div>
            <span class="badge <%= poll.status === 'active' ? 'badge-active' : 'badge-closed' %>">
              <%= poll.status === 'active' ? 'Активне' : 'Завершене' %>
            </span>
            <h1>Результати</h1>
            <p class="details-description"><%= poll.title %></p>
          </div>
          <div class="results-total">
            <span>Усього голосів</span>
            <strong><%= totalVotes %></strong>
          </div>
        </div>

        <% if (results && results.length > 0) { %>
          <div class="results-list">
            <% results.forEach(r => { %>
              <div class="result-card">
                <div class="result-card__head">
                  <h3><%= r.option %></h3>
                  <div class="result-card__numbers">
                    <span><%= r.votes %> голосів</span>
                    <strong><%= r.percent %>%</strong>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-box" style="margin-top:24px">
            <h3>Голосів ще немає</h3>
            <p>Результати з'являться після перших голосів.</p>
          </div>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('ejs/footer') %>
</body>
</html>