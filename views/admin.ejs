<!DOCTYPE html>
<html lang="uk">
<head>
  <%- include('ejs/head', { title: 'Адмін панель' }) %>
</head>
<body>
  <%- include('ejs/header') %>

  <main class="section">
    <div class="container admin-layout">
      <aside class="admin-sidebar">
        <h2>Адмін панель</h2>
        <nav class="admin-nav">
          <a href="/admin" class="admin-nav__link active">Мої голосування</a>
          <a href="/admin/polls/new" class="admin-nav__link">Створити голосування</a>
        </nav>
      </aside>

      <section class="admin-content">
        <div class="section-head">
          <div>
            <h1>Мої голосування</h1>
            <p class="section-subtitle">Керуйте голосуваннями, змінюйте статус і переглядайте результати</p>
          </div>

        <% if (polls && polls.length > 0) { %>
          <div class="admin-cards">
            <% polls.forEach(poll => { %>
              <article class="admin-poll-card">
                <div class="admin-poll-card__top">
                  <div>
                    <span class="badge <%= poll.status === 'active' ? 'badge-active' : 'badge-closed' %>">
                      <%= poll.status === 'active' ? 'Активне' : 'Завершене' %>
                    </span>
                    <h3><%= poll.title %></h3>
                  </div>
                  <span class="poll-date"><%= poll.createdAt %></span>
                </div>

                <div class="admin-poll-card__meta">
                  <div class="url-box">
                    <input
                      type="text"
                      value="<%= poll.url %>"
                      readonly
                      class="input url-input"
                    />
                    <button
                      type="button"
                      class="btn btn-secondary copy-btn"
                      data-copy-text="<%= poll.url %>"
                    >
                      Копіювати URL
                    </button>
                  </div>
                </div>

                <div class="admin-poll-card__actions">
                  <a href="/admin/polls/<%= poll.id %>/edit" class="btn btn-secondary btn-sm">Редагувати</a>
                  <a href="/polls/<%= poll.id %>/results" class="btn btn-secondary btn-sm">Результати</a>

                  <% if (poll.status === 'active') { %>
                    <form action="/admin/polls/<%= poll.id %>/stop" method="POST">
                      <button type="submit" class="btn btn-warning btn-sm">Зупинити</button>
                    </form>
                  <% } else { %>
                    <form action="/admin/polls/<%= poll.id %>/start" method="POST">
                      <button type="submit" class="btn btn-primary btn-sm">Запустити</button>
                    </form>
                  <% } %>

                  <form action="/admin/polls/<%= poll.id %>/delete" method="POST" class="delete-form">
                    <button type="submit" class="btn btn-danger btn-sm">Видалити</button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-box">
            <h3>У вас ще немає голосувань</h3>
            <p>Створіть перше голосування, щоб воно з’явилося тут.</p>
            <a href="/admin/polls/new" class="btn btn-primary">Створити голосування</a>
          </div>
        <% } %>
      </section>
    </div>
  </main>

  <%- include('ejs/footer') %>
</body>
</html>