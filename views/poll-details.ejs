<!DOCTYPE html>
<html lang="uk">
<head><%- include('ejs/head', { title: poll.title }) %></head>
<body>
  <%- include('ejs/header') %>
  <main class="section">
    <div class="container narrow-container">
      <div class="page-top">
        <a href="/" class="back-link">← Назад до всіх голосувань</a>
      </div>

      <section class="details-card">
        <div class="details-card__head">
          <div>
            <span class="badge <%= poll.status === 'active' ? 'badge-active' : 'badge-closed' %>">
              <%= poll.status === 'active' ? 'Активне' : 'Завершене' %>
            </span>
            <h1><%= poll.title %></h1>
            <p class="details-description"><%= poll.description %></p>
          </div>
        </div>

        <% if (alreadyVoted) { %>
          <div class="info-banner info-banner--warning" style="margin-top:18px">
            Ви вже проголосували в цьому голосуванні.
          </div>
          <div class="form-actions">
            <a href="/polls/<%= poll.id %>/results" class="btn btn-secondary">Переглянути результати</a>
          </div>

        <% } else if (poll.status !== 'active') { %>
          <div class="info-banner info-banner--muted" style="margin-top:18px">
            Голосування завершене. Нові голоси не приймаються.
          </div>
          <div class="form-actions">
            <a href="/polls/<%= poll.id %>/results" class="btn btn-secondary">Переглянути результати</a>
          </div>

        <% } else if (!user) { %>
          <div class="info-banner info-banner--warning" style="margin-top:18px">
            Щоб проголосувати, потрібно <a href="/login" style="color:inherit;font-weight:800">увійти в акаунт</a>.
          </div>

        <% } else { %>
          <form action="/polls/<%= poll.id %>/vote" method="POST" class="vote-form" id="voteForm">
            <div class="candidate-list">
              <% (poll.options || []).forEach((option, i) => { %>
                <label class="candidate-card">
                  <input type="radio" name="optionIndex" value="<%= i %>" class="candidate-radio" />
                  <div class="candidate-card__content">
                    <div class="candidate-card__top">
                      <h3><%= option %></h3>
                    </div>
                  </div>
                </label>
              <% }) %>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-lg">Віддати голос</button>
            </div>
          </form>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('ejs/footer') %>
</body>
</html>